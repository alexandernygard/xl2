{
  "name": "xl2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @xl2/web dev",
    "build": "pnpm --filter @xl2/web build",
    "test": "pnpm --filter @xl2/sdk test",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm build && wrangler deploy",
    "dev:worker": "pnpm --filter @xl2/worker dev"
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "wrangler": "^4.151.2"
  }
}
