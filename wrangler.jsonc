{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "xl2",
	"compatibility_date": "2026-10-18",
	"main": "apps/worker/src/index.ts",
	// Static assets are served from Cloudflare's edge without running the Worker; only /collab/* runs it.
	"assets": {
		"directory": "./apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/collab/*"]
	},
	// One Durable Object per shared workbook (SQLite-backed: required on the free plan).
	"durable_objects": { "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
	"routes": [{ "pattern": "xl2.nyggis.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true
}
