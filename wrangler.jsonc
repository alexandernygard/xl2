{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "xl2",
	"compatibility_date": "2026-10-18",
	"main": "apps/worker/src/index.ts",
	// Static assets are served from Cloudflare's edge without running the Worker; only /collab/* and /api/* run it.
	"assets": {
		"directory": "./apps/web/dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/collab/*", "/api/*"]
	},
	// One Durable Object per shared workbook (SQLite-backed: required on the free plan).
	"durable_objects": { "bindings": [{ "name": "DOC_ROOM", "class_name": "DocRoom" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocRoom"] }],
	"d1_databases": [
		// The assistant's sessions (ai-kit).
		{ "binding": "DB", "database_name": "xl2", "database_id": "54cbcc3b-c153-4592-b765-af17c5904eab", "migrations_dir": "apps/worker/migrations" },
		// Shared with auth.nyggis.com: per-user Claude spend (schema in the auth repo).
		{ "binding": "AI_USAGE", "database_name": "ai-usage", "database_id": "db320aa6-318c-4f8f-9684-691fe9f6423a" }
	],
	// The Claude key is a secret: ANTHROPIC_API_KEY, set in the Cloudflare dashboard.
	"observability": { "enabled": true },
	"routes": [{ "pattern": "xl2.nyggis.com", "custom_domain": true }],
	"workers_dev": false,
	"preview_urls": true
}
